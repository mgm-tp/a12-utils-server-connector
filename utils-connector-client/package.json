{
	"name": "@com.mgmtp.a12.utils/utils-connector",
	"version": "9.0.0-SNAPSHOT",
	"description": "mgm A12 Utility for Connector",
	"author": "mgm technology partners",
	"license": "(EUPL-1.2 OR LicenseRef-commercial)",
	"type": "module",
	"typings": "./lib/main/index.d.ts",
	"exports": "./lib/main/index.js",
	"readme": "README.md",
	"scripts": {
		"compile": "npm run lint && tsc",
		"clean": "rimraf node_modules lib",
		"typedoc": "typedoc ./src",
		"test": "mocha",
		"lint": "npm-run-all -p lint:eslint lint:prettier",
		"lint:eslint": "eslint ./src --ext .ts --quiet",
		"lint:prettier": "prettier --check \"{src,test}/**/*.{ts,tsx,json,js}\"",
		"lint:fix": "npm-run-all -p eslint:fix prettier:fix",
		"eslint:fix": "eslint --quiet --fix",
		"prettier:fix": "prettier --write \"{src,test}/**/*.{ts,tsx,json,js}\"",
		"sbom": "cyclonedx-npm --output-file cyclonedx.json --flatten-components",
		"test:api": "api-extractor run",
		"update:api": "api-extractor run --local"
	},
	"files": [
		"lib",
		"src",
		"doc",
		"README.md",
		"tsconfig.json",
		"package.json",
		"npm-shrinkwrap.json",
		"cyclonedx.json",
		"LICENSE",
		"NOTICE",
		"THIRD_PARTY_NOTICES",
		"licenses"
	],
	"devDependencies": {
		"@microsoft/api-extractor": "7.55.2",
		"@babel/core": "7.11.1",
		"@babel/register": "7.10.5",
		"@com.mgmtp.a12.devtools/tsconfig": "2.0.0",
		"@com.mgmtp.a12.devtools/eslint-config": "3.1.1",
		"@com.mgmtp.a12.devtools/prettier-config": "1.1.0",
		"@cyclonedx/cyclonedx-npm": "^4.1.1",
		"@types/base-64": "^0.1.2",
		"@types/fetch-mock": "7.3.2",
		"@types/jest": "^29.5.12",
		"@types/lodash": "^4.14.56",
		"@types/mocha": "^5.2.5",
		"@types/node": "22.13.5",
		"cross-env": "7.0.2",
		"eslint": "^9.14.0",
		"eslint-plugin-notice": "^1.0.0",
		"faker": "4.1.0",
		"fetch-mock": "9.10.7",
		"isomorphic-fetch": "^2.2.1",
		"jsdom-global": "3.0.2",
		"milsymbol": "2.0.0",
		"mocha": "^11.2.0",
		"mock-local-storage": "1.1.23",
		"node-fetch": "2.6.0",
		"npm-run-all": "4.1.5",
		"npm-watch": "0.1.9",
		"nyc": "14.1.1",
		"prettier": "^3.5.3",
		"rimraf": "2.6.2",
		"shx": "0.3.2",
		"testdouble": "2.1.2",
		"typedoc": "0.28.18",
		"typescript": "6.0.2",
		"ts-node": "10.9.2"
	},
	"prettier": "@com.mgmtp.a12.devtools/prettier-config"
}
